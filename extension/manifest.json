{
  "manifest_version": 3,
  "name": "FinPilot — is it worth it?",
  "version": "0.3.0",
  "description": "FinPilot: your family's money copilot inside Chrome. On any product page it checks your family budget, your usual prices and market prices: Buy, Think about it or Not worth it. Everything runs on this computer. Prototype, not financial advice.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open FinPilot"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api-m.sandbox.paypal.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detect.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
